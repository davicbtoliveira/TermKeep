# Multi-stage build for the TermKeep server image.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/termkeep-server ./cmd/termkeep-server

FROM alpine:3.21
RUN adduser -D -u 10001 termkeep
USER termkeep
COPY --from=build /out/termkeep-server /usr/local/bin/termkeep-server
EXPOSE 8080
ENTRYPOINT ["termkeep-server"]
