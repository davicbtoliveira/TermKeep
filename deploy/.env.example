# TermKeep reference deployment configuration. Copy to deploy/.env and edit.
# deploy/.env is gitignored; never commit real values.

# PostgreSQL password for the termkeep role. Generate one, e.g.:
#   openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Persistent OPAQUE server secrets. Generate once with:
#   go run ./cmd/termkeep-server opaque-keygen
# Losing or rotating either value makes existing accounts unable to log in.
OPAQUE_SERVER_KEY=change-me
OPAQUE_OPRF_SEED=change-me

# Security audit event retention in days.
AUDIT_RETENTION_DAYS=90

# Host port publishing Traefik's HTTPS endpoint.
TERMKEEP_HTTPS_PORT=443

# Loopback-only direct server port (operator debugging, tests).
TERMKEEP_SERVER_PORT=8080

# Directory holding ca.pem, tls.crt, tls.key (see generate-dev-certs.sh).
TERMKEEP_CERTS_DIR=./certs
